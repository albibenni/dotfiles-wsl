# Optional: scripts/setup.sh --git adds an include, preserving your identity.
[alias]
    st = status -sb
    lg = log --oneline --decorate --graph -30
    last = log -1 --stat
[init]
    defaultBranch = main
[merge]
    conflictStyle = zdiff3
[core]
    pager = delta
    autocrlf = input
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
